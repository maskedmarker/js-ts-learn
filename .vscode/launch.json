{
    // 配置文件版本号，固定写 0.2.0，不要修改，VSCode识别用
    "version": "0.2.0",
    // 调试配置数组，可以写多套调试方案，F5下拉框可以切换
    "configurations": [
        {
            // 调试器类型：node 代表NodeJS调试器
            "type": "node",
            // 请求类型：launch=启动新进程调试；attach=附加到已经在运行的node进程
            "request": "launch",
            // 名称，会出现在F5下拉选择框，自定义名字
            "name": "调试当前TS文件 (tsx)",
            // 用 npx 启动 tsx 运行 .ts 文件，无需预编译
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "tsx",
                "${file}"
            ],
            // 控制台输出位置
            // `integratedTerminal`：VSCode 内置终端（推荐，可以输入交互，`console.log`在这里输出）
            "console": "integratedTerminal",
            // 单步调试时，自动跳过这些文件，不进入
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
