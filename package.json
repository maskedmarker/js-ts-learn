    "inference": "tsx src/basic/03-type-inference.ts",
    "functions": "tsx src/basic/04-functions.ts",
    "objects": "tsx src/basic/05-objects-and-interfaces.ts",
    "arrays": "tsx src/basic/06-arrays-and-tuples.ts",
    "unions": "tsx src/basic/07-unions-and-narrowing.ts",
    "enums": "tsx src/basic/08-enums.ts",
    "generics": "tsx src/basic/09-generics.ts",
    "classes": "tsx src/basic/10-classes.ts",
    "utilities": "tsx src/basic/11-utility-types.ts",
    "async": "tsx src/basic/12-async-await.ts",
